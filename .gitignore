# ==========================================
# JavaLens / Java Project Analyzer - .gitignore
# ==========================================

# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# Node.js & Frontend dependencies/builds
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Portable tools
.tools/

# Embedded NoSQL Database & local app data
data/
*.redb
.javalens/

# Java / Maven / Gradle build outputs
*.class
*.jar
*.war
*.ear
.gradle/
build/
bin/
out/
.project
.classpath
.settings/

# IDE and Editor configurations
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temp files
*.log
tmp/
temp/

# Antigravity agent configuration
.antigravityignore

