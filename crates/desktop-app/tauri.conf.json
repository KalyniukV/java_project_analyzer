{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JavaLens",
  "version": "0.1.0",
  "identifier": "com.javalens.analyzer",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JavaLens — Java Architecture & Dependency Analyzer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {},
    "dialog": {}
  }
}
